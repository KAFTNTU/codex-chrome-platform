{
  "name": "codex-chrome-platform",
  "version": "0.6.5",
  "description": "Local browser automation platform with Chrome Bridge, MCP, Local API, native messaging, and cross-platform bridge autostart.",
  "main": "desktop-app/main.js",
  "private": true,
  "scripts": {
    "dev": "npm run bridge:autostart",
    "bridge:start": "node ./plugins/chrome-bridge/scripts/bridge_hub.js",
    "bridge:autostart": "node ./scripts/bridge_autostart.js",
    "desktop": "electron ./desktop-app/main.js",
    "build:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "ua.kaftntu.codex.chromeplatform",
    "productName": "Codex Chrome Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop-app/**/*",
      "plugins/**/*",
      "README.md",
      "package.json"
    ],
    "asarUnpack": [
      "plugins/chrome-bridge/**/*"
    ],
    "extraMetadata": {
      "main": "desktop-app/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "makensis": "^3.0.5",
    "nsis": "^0.0.0"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "tesseract.js": "^5.1.1"
  }
}
